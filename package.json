{
  "name": "moss-and-gold",
  "version": "0.13.12",
  "description": "Moss & Gold — A Living Dungeon Sim（苔と金貨）：見下ろし2Dのダンジョン生態系シミュレーション（段階13）",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "esbuild test/determinism.ts --bundle --platform=node --outfile=build/test.js --log-level=warning && node build/test.js",
    "export-sprites": "esbuild tools/export-sprites.ts --bundle --platform=node --outfile=build/export.js --log-level=warning && node build/export.js",
    "sim": "node tools/analysis/launch.mjs sim",
    "report": "node tools/analysis/launch.mjs report",
    "batch": "node tools/analysis/launch.mjs batch",
    "autopsy": "node tools/analysis/launch.mjs autopsy",
    "ab": "node tools/analysis/launch.mjs ab",
    "stuckmap": "node tools/analysis/launch.mjs stuckmap",
    "compare": "node tools/analysis/launch.mjs compare",
    "shot": "node build.mjs && esbuild tools/gallery/shot.ts --bundle --platform=node --outfile=build/shot.js --log-level=warning && node build/shot.js",
    "gallery": "node build.mjs && esbuild tools/gallery/scenes.ts --bundle --platform=node --outfile=build/scenes.js --log-level=warning && node tools/gallery/shoot.mjs",
    "probe": "node tools/analysis/launch.mjs probe",
    "check": "node tools/analysis/launch.mjs check",
    "metric": "node tools/analysis/launch.mjs metric",
    "bench": "node tools/analysis/launch.mjs bench"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "wrangler": "^4.156.2"
  },
  "private": true
}
